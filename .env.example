# ====================================================================
# NEXA STORE OS - FRONTEND ENVIRONMENT VARIABLES (Vercel / Vite)
# ====================================================================

# --------------------------------------------------------------------
# 1. Firebase Web SDK Configuration (REQUIRED)
# Found in: Firebase Console -> Project Settings -> General -> Your Apps -> Web app -> SDK setup and configuration
# --------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --------------------------------------------------------------------
# 2. Storefront Domain & Subdomain Configuration (OPTIONAL)
# --------------------------------------------------------------------
# Set to "true" only if you have configured wildcard DNS subdomains (e.g. *.nexastoreos.com)
VITE_USE_SUBDOMAINS=false
# Root domain for store vanity URLs
VITE_STORE_DOMAIN=nexastoreos.com
# Main landing page URL (used in printable QR flyers and promotional materials)
VITE_LANDING_URL=https://nexastoreos.com
