rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // HELPERS
    function isAuth() { return request.auth != null; }
    
    function getStoreId() { 
      return request.auth != null && request.auth.token.storeId != null ? 
        request.auth.token.storeId : 
        (request.auth != null && exists(/databases/$(database)/documents/staff/$(request.auth.uid)) ? 
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.storeId : 
          null);
    }
    
    function getRole() { 
      return request.auth != null && request.auth.token.role != null ? 
        request.auth.token.role : 
        (request.auth != null && exists(/databases/$(database)/documents/staff/$(request.auth.uid)) ? 
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role : 
          null);
    }
    
    // Role Helpers
    function isAdmin() { 
      let role = getRole();
      return role == 'admin' || role == 'owner' || role == 'system_admin'; 
    }
    
    function isManager() {
      let role = getRole();
      return isAdmin() || role == 'manager';
    }

    // ACTIVITY LOGS: Top priority logging
    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    // STORES: Publicly readable for tenant resolution (subdomain lookup)
    match /stores/{storeId} {
      allow read, write: if true;
      
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }
    
    // STAFF: Global lookup for claims sync and fallback
    match /staff/{staffId} {
      allow read, write: if true;
    }
    
    // USERS: Private profiles
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuth() && request.auth.uid == userId;
    }
    

    // MULTI-TENANT DATA: Gated by storeId claim with owner fallback
    match /{collectionName}/{docId} {
      allow read: if isAuth() && (
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        (resource.data.ownerId != null && request.auth.uid == resource.data.ownerId) ||
        (resource.data.storeId != null && get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.ownerId == request.auth.uid) ||
        isAdmin()
      );

      allow create: if isAuth() && (
        (getStoreId() != null && request.resource.data.storeId == getStoreId()) ||
        (request.resource.data.ownerId != null && request.auth.uid == request.resource.data.ownerId) ||
        (request.resource.data.storeId != null && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId == request.auth.uid) ||
        isAdmin()
      );

      allow update: if isAuth() && (
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        (resource.data.ownerId != null && request.auth.uid == request.resource.data.ownerId) ||
        (resource.data.storeId != null && get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.ownerId == request.auth.uid) ||
        isAdmin()
      );

      allow delete: if isAuth() && (
        (isAdmin() && getStoreId() != null && resource.data.storeId == getStoreId()) ||
        (resource.data.ownerId != null && request.auth.uid == request.resource.data.ownerId) ||
        (resource.data.storeId != null && get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.ownerId == request.auth.uid) ||
        isAdmin()
      );
    }
  }
}
