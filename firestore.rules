rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // HELPERS
    function isAuth() { return request.auth != null; }
    
    function getStoreId() { 
      return request.auth.token.storeId != null ? 
        request.auth.token.storeId : 
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) ? 
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.storeId : 
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeId :
            null));
    }
    
    function getRole() { 
      return request.auth.token.role != null ? 
        request.auth.token.role : 
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) ? 
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role : 
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role :
            null));
    }
    
    // Role Helpers
    function isAdmin() { 
      let role = getRole();
      return role == 'admin' || role == 'owner' || role == 'system_admin'; 
    }
    
    function isManager() {
      let role = getRole();
      return isAdmin() || role == 'manager';
    }

    // STORES: Publicly readable for tenant resolution (subdomain lookup)
    match /stores/{storeId} {
      allow read: if true; 
      allow create: if isAuth(); 
      allow update, delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || 
        isAdmin() || 
        (isManager() && getStoreId() == storeId)
      );
      
      match /{allSubcollections=**} {
        allow read, write: if isAuth() && (
          getStoreId() == storeId || 
          get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
      }
    }
    
    // USERS: Private profiles
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuth() && request.auth.uid == userId;
    }
    
    // STAFF: Global lookup for claims sync and fallback
    match /staff/{staffId} {
      allow read: if isAuth();
      allow write: if isAuth() && (
        request.resource.data.ownerId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    // PRODUCTS: Publicly readable so public store pages can browse items
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAuth() && (
        (getStoreId() != null && request.resource.data.storeId == getStoreId()) ||
        (request.resource.data.ownerId != null && request.auth.uid == request.resource.data.ownerId) ||
        isAdmin()
      );
      allow update: if (isAuth() && (
        (getStoreId() != null && request.resource.data.storeId == getStoreId()) ||
        (request.resource.data.ownerId != null && request.auth.uid == request.resource.data.ownerId) ||
        isAdmin()
      )) || (
        // Public checkout: only allowed to decrement/update stock
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentStock', 'updatedAt'])
      );
    }

    // CATEGORIES: Publicly readable for navigation
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuth() && (
        (getStoreId() != null && request.resource.data.storeId == getStoreId()) ||
        (request.resource.data.ownerId != null && request.auth.uid == request.resource.data.ownerId) ||
        isAdmin()
      );
    }

    // SALES: Public checkout creates a transaction and reads a specific receipt
    match /sales/{saleId} {
      allow create, read: if true;
      allow update, delete: if isAuth() && (
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        (resource.data.ownerId != null && request.auth.uid == resource.data.ownerId) ||
        isAdmin()
      );
    }

    // MOVEMENTS: Public checkout records stock decrement movements
    match /movements/{movementId} {
      allow create: if true;
      allow read, update, delete: if isAuth() && (
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        (resource.data.ownerId != null && request.auth.uid == resource.data.ownerId) ||
        isAdmin()
      );
    }

    // MULTI-TENANT DATA: Gated by storeId claim with owner fallback
    match /{collectionName}/{docId} {
      allow read: if isAuth() && (
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        (resource.data.ownerId != null && request.auth.uid == resource.data.ownerId) ||
        (resource.data.storeId != null && get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.ownerId == request.auth.uid) ||
        isAdmin()
      );

      allow create: if isAuth() && (
        (getStoreId() != null && request.resource.data.storeId == getStoreId()) ||
        (request.resource.data.ownerId != null && request.auth.uid == request.resource.data.ownerId) ||
        (request.resource.data.storeId != null && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId == request.auth.uid) ||
        isAdmin()
      );

      allow update: if isAuth() && (
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        (resource.data.ownerId != null && request.auth.uid == resource.data.ownerId) ||
        (resource.data.storeId != null && get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.ownerId == request.auth.uid) ||
        isAdmin()
      );

      allow delete: if isAuth() && (
        (isAdmin() && getStoreId() != null && resource.data.storeId == getStoreId()) ||
        (resource.data.ownerId != null && request.auth.uid == resource.data.ownerId) ||
        (resource.data.storeId != null && get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.ownerId == request.auth.uid) ||
        isAdmin()
      );
    }
    
    // ACTIVITY LOGS: Logging only
    match /activity_logs/{logId} {
      allow create: if isAuth();
      allow read: if isAuth() && (
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        (resource.data.ownerId != null && request.auth.uid == resource.data.ownerId) ||
        isAdmin()
      );
    }
  }
}
