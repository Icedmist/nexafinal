rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // HELPERS
    function isAuth() { return request.auth != null; }
    function getStoreId() { return request.auth.token.storeId; }
    function getRole() { return request.auth.token.role; }
    function isAdmin() { return getRole() == 'admin' || getRole() == 'owner'; }

    // STORES: Publicly readable for tenant resolution, only owner can edit
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isAuth() && (request.auth.uid == resource.data.ownerId || isAdmin());
    }

    // USERS: Private profiles
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || (isAdmin() && request.auth.token.storeId != null));
      allow write: if isAuth() && request.auth.uid == userId;
    }
    
    // ACTIVITY LOGS: Allow anyone to log events (for audit), but restrict reading
    match /activity_logs/{logId} {
      allow create: if isAuth();
      allow read: if isAuth() && (
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        (resource.data.ownerId != null && request.auth.uid == resource.data.ownerId) ||
        isAdmin()
      );
    }

    // MULTI-TENANT DATA: Gated by storeId claim with fallbacks
    match /{collectionName}/{docId} {
      allow read, write: if collectionName != 'stores' && collectionName != 'users' && collectionName != 'activity_logs' && isAuth() && (
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        (resource.data.ownerId != null && request.auth.uid == resource.data.ownerId) ||
        (resource.data.storeId != null && request.auth.uid == get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.ownerId) ||
        isAdmin()
      );
        
      allow create: if collectionName != 'stores' && collectionName != 'users' && collectionName != 'activity_logs' && isAuth() && (
        (getStoreId() != null && request.resource.data.storeId == getStoreId()) ||
        (request.resource.data.storeId != null && request.auth.uid == get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId) ||
        (request.resource.data.ownerId != null && request.auth.uid == request.resource.data.ownerId)
      );
    }
  }
}
