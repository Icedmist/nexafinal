rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // HELPERS
    function isAuth() { return request.auth != null; }
    
    function getStoreId() { 
      return request.auth.token.storeId != null ? 
        request.auth.token.storeId : 
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) ? 
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.storeId : 
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeId :
            null));
    }
    
    function getRole() { 
      return request.auth.token.role != null ? 
        request.auth.token.role : 
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) ? 
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role : 
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role :
            null));
    }
    
    // Role Helpers
    function isAdmin() { 
      let role = getRole();
      return role == 'admin' || role == 'owner' || role == 'system_admin'; 
    }
    
    function isManager() {
      let role = getRole();
      return isAdmin() || role == 'manager';
    }

    // Store scoping: the caller must be authenticated AND belong to the given store.
    function isStoreScoped(storeId) {
      return isAuth() && getStoreId() != null && getStoreId() == storeId;
    }

    // STORES: Publicly readable for tenant resolution (subdomain/slug lookup) and
    // for the public storefront (store name, contact details, and the payment
    // instructions customers need to transfer funds). Storefront writes remain
    // restricted to the store owner / admins.
    match /stores/{storeId} {
      allow read: if true; 
      allow create: if isAuth(); 
      allow update, delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || 
        isAdmin() || 
        (isManager() && getStoreId() == storeId)
      );
      
      match /{allSubcollections=**} {
        allow read, write: if isAuth() && (
          getStoreId() == storeId || 
          get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
      }
    }
    
    // USERS: Private profiles
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuth() && request.auth.uid == userId;
    }
    
    // STAFF: Global lookup for claims sync and fallback
    match /staff/{staffId} {
      // Scoped to the same store (or self), so managers can only view their
      // own store's team. Admins may view any staff record.
      allow read: if isAuth() && (
        request.auth.uid == staffId ||
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        isAdmin()
      );
      allow write: if isAuth() && (
        request.resource.data.ownerId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    // PRODUCTS: NO anonymous reads. Products carry sensitive fields (cost price,
    // supplier, reorder levels), so reads require an authenticated caller of the
    // SAME store (or an admin). Branch-level filtering is enforced client-side.
    // The public storefront must use the getpubliccatalog callable function,
    // which returns only non-sensitive fields. The anonymous checkout may still
    // decrement stock via the update carve-out below (currentStock/updatedAt only).
    match /products/{productId} {
      allow read: if isAuth() && (
        isStoreScoped(resource.data.storeId) ||
        isAdmin()
      );
      allow create, delete: if isAuth() && (
        (getStoreId() != null && request.resource.data.storeId == getStoreId()) ||
        (request.resource.data.ownerId != null && request.auth.uid == request.resource.data.ownerId) ||
        isAdmin()
      );
      allow update: if (isAuth() && (
        (getStoreId() != null && request.resource.data.storeId == getStoreId()) ||
        (request.resource.data.ownerId != null && request.auth.uid == request.resource.data.ownerId) ||
        isAdmin()
      )) || (
        // Public checkout: only allowed to decrement/update stock
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentStock', 'updatedAt'])
      );
    }

    // CATEGORIES: not sensitive, but reads are still store-scoped; the public
    // storefront receives categories through the getpubliccatalog function.
    match /categories/{categoryId} {
      allow read: if isAuth() && (
        isStoreScoped(resource.data.storeId) ||
        isAdmin()
      );
      allow write: if isAuth() && (
        (getStoreId() != null && request.resource.data.storeId == getStoreId()) ||
        (request.resource.data.ownerId != null && request.auth.uid == request.resource.data.ownerId) ||
        isAdmin()
      );
    }

    // SALES: Public checkout creates a sale and pays by transfer (no receipt is
    // read back — the guest flow renders the receipt from local state). Reads are
    // restricted to authenticated callers of the same store (or the record's
    // owner, or admins — needed for the system-admin global sales monitor).
    match /sales/{saleId} {
      allow create: if true;
      allow read: if isAuth() && (
        isStoreScoped(resource.data.storeId) ||
        (resource.data.ownerId != null && request.auth.uid == resource.data.ownerId) ||
        isAdmin()
      );
      allow update, delete: if isAuth() && (
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        (resource.data.ownerId != null && request.auth.uid == resource.data.ownerId) ||
        isAdmin()
      );
    }

    // MOVEMENTS: Public checkout records stock decrement movements (create only).
    match /movements/{movementId} {
      allow create: if true;
      allow read, update, delete: if isAuth() && (
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        (resource.data.ownerId != null && request.auth.uid == resource.data.ownerId) ||
        isAdmin()
      );
    }

    // MULTI-TENANT DATA: Gated by storeId claim with owner fallback
    match /{collectionName}/{docId} {
      allow read: if isAuth() && (
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        (resource.data.ownerId != null && request.auth.uid == resource.data.ownerId) ||
        (resource.data.storeId != null && get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.ownerId == request.auth.uid) ||
        isAdmin()
      );

      allow create: if isAuth() && (
        (getStoreId() != null && request.resource.data.storeId == getStoreId()) ||
        (request.resource.data.ownerId != null && request.auth.uid == request.resource.data.ownerId) ||
        (request.resource.data.storeId != null && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId == request.auth.uid) ||
        isAdmin()
      );

      allow update: if isAuth() && (
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        (resource.data.ownerId != null && request.auth.uid == resource.data.ownerId) ||
        (resource.data.storeId != null && get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.ownerId == request.auth.uid) ||
        isAdmin()
      );

      allow delete: if isAuth() && (
        (isAdmin() && getStoreId() != null && resource.data.storeId == getStoreId()) ||
        (resource.data.ownerId != null && request.auth.uid == resource.data.ownerId) ||
        (resource.data.storeId != null && get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.ownerId == request.auth.uid) ||
        isAdmin()
      );
    }
    
    // CUSTOMER CREDIT: store prepaid balances. Docs are keyed `${storeId}_${phone}`.
    // Reads must tolerate not-yet-created docs (resource == null) because the
    // mutations read the balance inside a transaction before the very first write.
    match /customer_credits/{docId} {
      allow read: if isAuth() && (
        resource == null ||
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        isAdmin()
      );
      allow create: if isAuth() && (
        (getStoreId() != null && request.resource.data.storeId == getStoreId()) ||
        isAdmin()
      );
      allow update: if isAuth() && (
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // CREDIT TOPUP LEDGER: immutable audit trail of every balance movement.
    match /credit_topups/{docId} {
      allow read: if isAuth() && (
        resource == null ||
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        isAdmin()
      );
      allow create: if isAuth() && (
        (getStoreId() != null && request.resource.data.storeId == getStoreId()) ||
        isAdmin()
      );
      allow update: if false;
      allow delete: if isAdmin();
    }

    // SALES FORMS / RECEIPTS: saved line-item documents (receipts, proforma
    // invoices, delivery notes, credit notes). Store-scoped; no inventory impact.
    match /sales_forms/{formId} {
      allow read, create, update, delete: if isAuth() && (
        (getStoreId() != null &&
          (request.resource.data.storeId == getStoreId() || resource.data.storeId == getStoreId())) ||
        isAdmin()
      );
    }

    // ACTIVITY LOGS: Logging only. Deletes are reserved for system admins / the
    // store owner so the system-admin data wipe can fully clear this collection.
    match /activity_logs/{logId} {
      allow create: if isAuth();
      allow read: if isAuth() && (
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        (resource.data.ownerId != null && request.auth.uid == resource.data.ownerId) ||
        isAdmin()
      );
      allow delete: if isAuth() && (
        (getStoreId() != null && resource.data.storeId == getStoreId()) ||
        (resource.data.ownerId != null && request.auth.uid == resource.data.ownerId) ||
        isAdmin()
      );
    }
  }
}
