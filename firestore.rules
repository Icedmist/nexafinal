rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // HELPERS
    function isAuth() { return request.auth != null; }
    function getStoreId() { return request.auth.token.storeId; }
    function getRole() { return request.auth.token.role; }
    function isAdmin() { return getRole() == 'admin' || getRole() == 'owner'; }

    // STORES: Publicly readable for tenant resolution, only owner can edit
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isAuth() && (request.auth.uid == resource.data.ownerId || isAdmin());
    }

    // USERS: Private profiles
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || (isAdmin() && request.auth.token.storeId != null));
      allow write: if isAuth() && request.auth.uid == userId;
    }

    // MULTI-TENANT DATA: Gated by storeId claim with a fallback for owners without claims yet
    match /{collectionName}/{docId} {
      allow read, write: if isAuth() && (
        // 1. High Performance: Custom Claims
        (getStoreId() != null && getStoreId() == resource.data.storeId) ||
        // 2. Migration Fallback: Check Store Ownership (Costs 1 Read)
        (getStoreId() == null && request.auth.uid == get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.ownerId)
      );
        
      allow create: if isAuth() && (
        // Must attach assigned storeId
        (getStoreId() != null && request.resource.data.storeId == getStoreId()) ||
        // Owner fallback for initial setup
        (getStoreId() == null && request.auth.uid == get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId)
      );
    }
  }
}
